# Arvian Marketing CRM Environment Configuration Template

# Database: SQLite for local zero-config, PostgreSQL/Supabase for production
# For SQLite local:
DATABASE_URL="file:./dev.db"
# For Supabase / PostgreSQL:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT Secret for Session Authentication
JWT_SECRET="your-secure-jwt-secret-key-at-least-32-chars"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Agency Defaults
DEFAULT_AGENCY_NAME="Arvian Marketing"
DEFAULT_TIMEZONE="Asia/Kolkata"
DEFAULT_CURRENCY="INR"

# Meta Marketing API Configuration
META_APP_ID=""
META_APP_SECRET=""
META_ACCESS_TOKEN=""

# WhatsApp Business API Configuration
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# SMTP Email Configuration
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# External Lead Ingestion Webhook Key (Zapier, Pabbly, Meta Ads)
WEBHOOK_API_KEY="your-lead-webhook-key-here"

